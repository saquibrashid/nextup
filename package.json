{
  "name": "nextup",
  "private": true,
  "version": "0.0.0",
  "description": "One deduplicated, owner-reviewed watchlist across streaming services, fed by screenshot upload.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "packages/domain",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test:web": "vitest run --project web --passWithNoTests",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:int && npm run test:web"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
