{
  "name": "nextup",
  "private": true,
  "version": "0.0.0",
  "description": "One deduplicated, owner-reviewed watchlist across streaming services, fed by screenshot upload.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "packages/domain",
    "apps/api",
    "apps/web",
    "tools/eslint-plugin-nextup"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test:unit": "vitest run --project unit",
    "db:test": "npm run db:test:create && npm run db:test:migrate",
    "db:test:create": "docker compose -f docker-compose.test.yml exec -T mssql /opt/mssql-tools18/bin/sqlcmd -C -I -S localhost -U sa -P \"Str0ng!Passw0rd_ci\" -b -Q \"IF DB_ID('nextup_test') IS NULL CREATE DATABASE [nextup_test] COLLATE Latin1_General_100_BIN2;\"",
    "db:test:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test:web": "vitest run --project web --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts --pass-with-no-tests",
    "golden": "vitest run --project golden --passWithNoTests",
    "test:infra": "vitest run --project infra",
    "check:audit": "node tools/check-audit.mjs",
    "check:deps": "node tools/check-deps.mjs",
    "notices": "node tools/check-licences.mjs",
    "check:licences": "node tools/check-licences.mjs --check",
    "status": "node tools/check-status.mjs",
    "check:status": "node tools/check-status.mjs --check",
    "check:test-ids": "node tools/check-test-ids.mjs",
    "check:orphans": "node tools/check-orphan-tests.mjs",
    "check:decisions": "node tools/check-decision-verifiability.mjs",
    "infra:build": "node tools/check-infra.mjs && prettier --write --log-level warn infra/main.json infra/budget.json",
    "check:infra": "node tools/check-infra.mjs --check",
    "check:test-locations": "node tools/check-test-locations.mjs",
    "check:credentials": "node tools/check-no-credentials.mjs",
    "check:outbound": "node tools/check-outbound-hosts.mjs",
    "check:mutating-routes": "node tools/check-mutating-routes.mjs",
    "check:write-once": "node tools/check-write-once-date-added.mjs",
    "test:meta": "vitest run --project meta --passWithNoTests",
    "coverage": "vitest run --project unit --project web --coverage",
    "test": "npm run test:unit && npm run test:int && npm run test:web"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-nextup": "*",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "msw": "2.15.0",
    "prettier": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
