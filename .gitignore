# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test / coverage artefacts
coverage/
.vitest/
# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
blob-report/

# Prisma
prisma/*.db
prisma/*.db-journal

# Secrets and local env — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.log

# Scratch files used while driving git/CI from PowerShell. commitmsg.tmp is how
# a multi-line commit message reaches `git commit -F` on a shell with no heredoc;
# it and any extracted-CI-step probes must never be committed.
commitmsg.tmp
_step.sh
_env.txt

dist-dev/

# Scratch output from ad-hoc z CLI calls. NEVER commit these: z ad app
# credential reset writes the client secret to the file it is redirected to,
# and this repository is public.
.az-*
