# nextup — environment variables (EXAMPLE)
# ---------------------------------------------------------------------------
# Copy to `.env` for local development and fill in real values. NEVER commit
# `.env`. In Azure these are Container Apps secrets / Key Vault references, not
# a file. Every value below is a PLACEHOLDER.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# Node environment. `production` disables debug logging (specs/security.md).
NODE_ENV=development
# Port the single process (API + built SPA) listens on.
PORT=3000
# Log level. `debug` is only permitted below production; default is `info`.
LOG_LEVEL=info

# --- Database (Azure SQL, provider `sqlserver`) ------------------------------
# Prisma connection string. Form is FIXED — see specs/data-model.md §16.1.1.
# Preferred auth is managed identity (secretless), decided at M0 (TASK-141);
# the fallback below is a Key-Vault SQL login that does NOT auto-expire.
# For local dev against the mssql container, encrypt=true;trustServerCertificate=true.
DATABASE_URL="sqlserver://localhost:1433;database=nextup;user=sa;password=__REPLACE_ME__;encrypt=true;trustServerCertificate=true;connectionLimit=5"

# --- Authentication (Container Apps Easy Auth) -------------------------------
# Comma-separated allow-list of Entra subject ids permitted to use the app.
# The middleware fails CLOSED: an empty list admits nobody (specs/security.md §3).
NEXTUP_ALLOWED_SUBJECTS=
# Bootstrap helper: logs the first rejected subject id then STILL refuses (403).
# Default false. NEVER set true in production (specs/security.md).
NEXTUP_BOOTSTRAP_ALLOW_FIRST=false

# --- Extraction: which reader is active --------------------------------------
# `hybrid` (DEFAULT, ADR-0001 Rev 2 — gpt-4.1 vision + Azure AI Vision Read
# cross-check), `llm-vision` (vision only, NO cross-check — diagnostics only),
# `azure-vision-read` (Rev 1 behaviour), or `stub` (deterministic test
# extractor). See specs/ai.md §2.3.
#
# ⚠ Corrected (A48): this read `llm-vision`, contradicting specs/ai.md §2.3 and
# the backlog, both of which specify `hybrid`. Rev 2 made the deterministic OCR
# cross-check part of the default pipeline, so defaulting to `llm-vision`
# silently drops it — an NFR-012a quality downgrade that would have shipped as
# the default.
NEXTUP_EXTRACTOR=hybrid

# --- Extraction: Azure OpenAI (gpt-4.1 vision, primary) ----------------------
# Endpoint and deployment name are CONFIG, not secrets. Auth is managed identity
# (Cognitive Services OpenAI User) — KEY-BASED AUTH IS PROHIBITED, there is no
# AZURE_OPENAI_API_KEY (T-INFRA-001, specs/security.md §6).
NEXTUP_AOAI_ENDPOINT=https://__REPLACE_ME__.openai.azure.com/
NEXTUP_AOAI_DEPLOYMENT=gpt-4.1

# --- Extraction: Azure AI Vision Read F0 (OCR cross-check) -------------------
# Endpoint only; auth is managed identity. No key here.
NEXTUP_VISION_ENDPOINT=https://__REPLACE_ME__.cognitiveservices.azure.com/

# --- Metadata: TMDB ----------------------------------------------------------
# TMDB API key. In Azure this is a Container Apps SECRET, never logged, never
# sent to any AI service (specs/ai.md, specs/security.md §6).
#
# ⚠ Use the "API Key (v3 auth)" — 32 hex characters — NOT the "API Read Access
# Token (v4 auth)", the long JWT starting `eyJ`. Both are on the same TMDB
# settings page. The client uses TMDB's v3 query-parameter scheme, so a v4
# token gets a 401 that surfaces as TMDB_UNAVAILABLE ("try again in a moment"),
# which reads as an outage and never resolves. See
# docs/runbooks/config-checklist.md §1.4.
TMDB_API_KEY=__REPLACE_ME__

# --- Screenshot storage (Azure Blob) -----------------------------------------
# Auth is managed identity — Storage Blob Data Contributor on THIS environment's
# container only. No account key, no SAS (ADR-0006).
#
# ⚠ AZURE_STORAGE_BLOB_ENDPOINT IS THE SWITCH BETWEEN THE TWO AUTH PATHS, and
# it WINS over AZURE_STORAGE_CONNECTION_STRING when both are set. That order is
# deliberate: a connection string carries an AccountKey, so if it won, one
# stray variable would silently downgrade a real deployment to a long-lived
# credential and everything would keep working. Set the endpoint in Azure;
# leave it UNSET locally so Azurite's connection string is used.
#
# ⚠ AZURE_STORAGE_ACCOUNT is read by NOTHING. Kept only because it is a
# convenient handle for `az storage` commands; do not add code that depends on
# it without also setting it in infra/aca.bicep, where it is currently absent.
AZURE_STORAGE_ACCOUNT=__REPLACE_ME__
AZURE_STORAGE_BLOB_ENDPOINT=https://__REPLACE_ME__.blob.core.windows.net/
# The container for THIS environment: `screenshots` in prod,
# `screenshots-staging` in staging. Defaults to `screenshots` when unset, which
# is right for prod and local dev and WRONG for staging — rbac.bicep grants each
# environment access to its own container only, so staging must set this.
AZURE_STORAGE_CONTAINER=screenshots
# Local dev / integration only. Azurite; never a real account key.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# --- Container registry (ghcr.io) --------------------------------------------
# There is deliberately NO registry credential, and none may be added. The
# ghcr.io package is PUBLIC: CI pushes with the built-in GITHUB_TOKEN and
# Container Apps pulls ANONYMOUSLY. infra/aca.bicep has no `registries` block
# on purpose (TASK-146, docs/ghcr-pat.md, docs/runbooks/config-checklist.md
# §1.6).
#
# ⚠ Corrected (TASK-133, 2026-08-20): this block previously read
#   GHCR_PULL_TOKEN=__REPLACE_ME__
# with a comment describing a "fine-grained PAT (read:packages)". That
# instructed the reader to create a credential the architecture forbids — and
# a fine-grained PAT CANNOT authenticate to ghcr.io at all, which is the
# reason docs/ghcr-pat.md exists. Adding one converts anonymous pulls that
# work into authenticated pulls that fail.
