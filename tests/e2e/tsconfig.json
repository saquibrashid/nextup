{
  // ⚠ A DRIFT ALARM, not a build. `tsc --noEmit -p tests/e2e/tsconfig.json`
  // typechecks the e2e specs — and, transitively, the STATEFUL stub in
  // `journey.spec.ts` against the real `@nextup/domain` and `apps/web` response
  // types it is declared with. A server-side shape change then fails HERE
  // instead of passing silently against a fiction (see the header of
  // `journey.spec.ts`, Part 2).
  //
  // ⚠ This config IS part of `npm run typecheck` — the root script is
  // `tsc --build && npm run typecheck:e2e`, so CI's `1 · lint` job runs it on
  // every push. It is NOT in the root `tsconfig.json` `references` array and
  // must not be added there: `tsc --build` requires a referenced project to be
  // `composite`, and a composite project emits build info and declarations for
  // a directory that produces no build output. Running it as a separate
  // `--noEmit` invocation keeps the alarm outside the build graph, which is
  // where it belongs.
  //
  // `T-INFRA-016` asserts the wiring, so deleting the `&&` fails CI rather than
  // silently returning the e2e specs to being unchecked.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
